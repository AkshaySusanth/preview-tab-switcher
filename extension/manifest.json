{
  "manifest_version": 3,
  "name": "Arc-like Tab Switcher",
  "version": "1.0",
  "description": "Preview and switch tabs like Arc browser.",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Switcher"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Open Tab Switcher"
    }
  }
}
